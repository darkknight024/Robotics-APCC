# Doxyfile for Robotics-APCC
# Doxygen configuration for Python documentation
# Generated for comprehensive project documentation

PROJECT_NAME           = "Robotics-APCC"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Robotic toolpath feasibility analysis and IK/FK solvers"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/doxygen_output
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Input and exclusions
INPUT                  = . \
                        core \
                        utils \
                        tests \
                        config
FILE_PATTERNS          = *.py *.yaml *.yml
EXCLUDE                = Assets/ \
                        Robot_APCC/ \
                        __pycache__/ \
                        .git/ \
                        *.pyc
EXCLUDE_PATTERNS       = */__pycache__/* \
                        */\.* \
                        */.git/*
RECURSIVE              = YES
EXCLUDE_SYMLINKS       = YES

# Python-specific: treat Python as input
EXTENSION_MAPPING      = .py=Python

# Extraction
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_HEADERFILE        = NO
INLINE_INHERITED_MEMB  = YES

# Cross-references
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION   = YES
USE_HTAGS             = NO
VERBATIM_HEADERS      = NO
CLANG_ASSISTED_PARSING = NO

# Preprocessor (minimal for Python)
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             =
SEARCH_INCLUDES       = YES
INCLUDE_PATH           =
INCLUDE_FILE_PATTERNS   =
USE_STL_FILE_NAMES     = YES

# Diagrams (optional)
HAVE_DOT              = NO
DOT_IMAGE_FORMAT      = png

# Output formats
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# HTML output
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = auto
HTML_DYNAMIC_SECTIONS  = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
FORMULA_FONTSIZE       = 10

# Main page
USE_MDFILE_AS_MAINPAGE = docs/doxygen/mainpage.md

# Misc
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED  = YES
WARN_IF_DOC_ERROR      = YES
